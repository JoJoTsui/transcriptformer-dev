+            owned.append((name, fd, (opened.st_dev, opened.st_ino)))
+        fd = os.open(foreign, os.O_RDONLY | os.O_NOFOLLOW)
+        opened = ordinary_fstat(fd)
+        foreign_descriptors.append((fd, (opened.st_dev, opened.st_ino)))
