+class _Cleanup:
+    def __init__(self):
+        self.error = None
+
+    def attempt(self, function, *args):
+        try:
+            function(*args)
+        except BaseException as error:
+            if self.error is None:
+                self.error = error
+
+    def finish(self):
+        if self.error is not None:
+            raise self.error
