+def _after_summary_fsync(monkeypatch, callback):
+    ordinary, fired = os.fsync, []
+
+    def fsync(fd):
+        ordinary(fd)
+        if not fired and Path(os.readlink(f"/proc/self/fd/{fd}")).name == "summary.json":
+            fired.append(True)
+            callback()
+
+    monkeypatch.setattr(os, "fsync", fsync)
+    return fired
+
