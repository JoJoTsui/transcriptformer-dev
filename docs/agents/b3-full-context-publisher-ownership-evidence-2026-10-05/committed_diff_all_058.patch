+            ("workspace_context_fd", True),
+            ("workspace_snapshot_fd", True),
+            ("workspace_cleanup_parent_fd", True),
+            ("workspace_fd", True),
+            ("parent_fd", True),
+            ("claim_fd", False),
+            ("output_fd", True),
+            ("staging_fd", True),
+            ("marker_fd", False),
